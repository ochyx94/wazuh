<!-- ============================================================
     POWERSHELL LOG RULES
     ============================================================ -->

<!-- PowerShell Encoded Command - CRITICAL -->
<rule id="100300" level="12">
  <match>4103|4104</match>
  <regex>-enc|-encodedcommand|EncodedCommand</regex>
  <description>PowerShell encoded command detected</description>
  <group>execution,powershell,mimikatz,incident</group>
</rule>

<!-- Suspicious PowerShell Download Pattern -->
<rule id="100301" level="12">
  <match>4103|4104</match>
  <regex>DownloadString|DownloadFile|Invoke-Expression|IEX</regex>
  <description>Suspicious PowerShell download/execution pattern</description>
  <group>execution,powershell,malware,incident</group>
</rule>

<!-- PowerShell Network Activity -->
<rule id="100302" level="10">
  <match>4103|4104</match>
  <regex>http://|https://</regex>
  <description>PowerShell network activity detected</description>
  <group>execution,network,powershell</group>
</rule>

<!-- New-Object System.Net (Suspicious) -->
<rule id="100303" level="10">
  <match>4103|4104</match>
  <regex>New-Object.*System\.Net</regex>
  <description>PowerShell network object creation</description>
  <group>execution,powershell</group>
</rule>

