<!-- ============================================================
     SECURITY LOG RULES
     ============================================================ -->

<!-- Brute Force Detection (4625) -->
<rule id="100002" level="10">
  <match>4625</match>
  <description>Login failed - possible brute force attack</description>
  <group>authentication_failure,brute_force</group>
</rule>

<!-- Admin Privileges Assigned (4672) -->
<rule id="100003" level="10">
