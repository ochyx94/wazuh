WAZUH AGENT CONFIG - SEMUA KATEGORI (MERGED)
================================================================================
Monitor: Windows Event Logs untuk SIEM
================================================================================

<!-- ============================================================
     SECURITY LOG - Account, Logon, Privilege
     Event IDs: 4624, 4625, 4634, 4648, 4670, 4672, 4719, 4720-4738, 4740, 4765, 4767, 4778, 4779
     ============================================================ -->
<ossec_config>
  <localfile>
    <log_format>eventlog</log_format>
    <location>Security</location>
  </localfile>

  <!-- ============================================================
       SYSTEM LOG - Service, Shutdown, Policy
       Event IDs: 6005, 6006, 6008, 7000, 7030, 7036, 7040, 7045, 1001, 1040
       ============================================================ -->
  <localfile>
    <log_format>eventlog</log_format>
    <location>System</location>
  </localfile>

  <!-- ============================================================
       APPLICATION LOG - App Crash, Hang
       Event IDs: 1000, 1001, 1074, 1076
       ============================================================ -->
  <localfile>
    <log_format>eventlog</log_format>
    <location>Application</location>
  </localfile>

  <!-- ============================================================
       POWERSHELL LOGGING - Script Block & Module Logging
       Event IDs: 400, 403, 4103, 4104, 4010, 600, 8004, 8193, 8194
       REQUIREMENT: Enable Script Block & Module Logging di Windows
       ============================================================ -->
  <localfile>
    <log_format>eventchannel</log_format>
    <location>Microsoft-Windows-PowerShell/Operational</location>
  </localfile>

  <!-- ============================================================
       WMI ACTIVITY LOGGING - Lateral Movement Detection
       Event IDs: 5857, 5858, 5859, 5860, 5861
       ============================================================ -->
  <localfile>
    <log_format>eventchannel</log_format>
    <location>Microsoft-Windows-WMI-Activity/Operational</location>
  </localfile>

  <!-- ============================================================
       WINDOWS DEFENDER / ANTIVIRUS
       Event IDs: 1116, 1117, 1000, 1001, 1002, 1010, 1121
       ============================================================ -->
  <localfile>
    <log_format>eventchannel</log_format>
    <location>Microsoft-Windows-Windows Defender/Operational</location>
  </localfile>

  <!-- ============================================================
       RDP CLIENT LOGGING (Optional)
       ============================================================ -->
  <localfile>
    <log_format>eventchannel</log_format>
    <location>Microsoft-Windows-TerminalServices-RDPClient/Operational</location>
  </localfile>

</ossec_config>

================================================================================
HOW TO ENABLE LOGGING DI WINDOWS (JALANKAN SEBAGAI ADMIN)
================================================================================

--- POWERSHELL LOGGING ---
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ModuleLogging" /v EnableModuleLogging /t REG_DWORD /d 1 /f
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ModuleLogging\ModuleNames" /v * /t REG_SZ /d * /f
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging" /v EnableScriptBlockLogging /t REG_DWORD /d 1 /f

--- WMI LOGGING ---
wevtutil sl "Microsoft-Windows-WMI-Activity/Operational" /ms:52428800 /rt:true /ab:true

--- DEFENDER LOGGING ---
wevtutil sl "Microsoft-Windows-Windows Defender/Operational" /ms:104857600 /rt:true /ab:true

--- RDP LOGGING ---
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server" /v AuditLogon /t REG_DWORD /d 1 /f

--- ENABLE PROCESS CREATION AUDIT (4688) ---
auditpol /set /subcategory:"Process Creation" /success:enable /failure:enable

--- ENABLE FILE SHARE AUDIT ---
auditpol /set /subcategory:"File Share" /success:enable /failure:enable

